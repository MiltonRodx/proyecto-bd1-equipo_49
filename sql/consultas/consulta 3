 - CONSULTA 3
-- Vendedores con dos o más ventas.

SELECT
    p.nombre + ' ' + p.apellido AS vendedor,
    pc.nombre + ' ' + pc.apellido AS cliente,
    mm.nombre_modelo AS modelo,
    COUNT(v.cod_venta) AS cantidad_ventas,
    SUM(v.monto_total) AS total_vendido

FROM venta v

-- Relacionamos la venta con el vendedor.
INNER JOIN vendedor ve
    ON v.dni_vendedor = ve.dni_vendedor
INNER JOIN persona p
    ON ve.dni_vendedor = p.dni

-- Relacionamos la venta con el cliente.
INNER JOIN cliente c
    ON v.dni_cliente = c.dni_cliente
INNER JOIN persona pc
    ON c.dni_cliente = pc.dni

-- Obtenemos el modelo de motocicleta vendido.
INNER JOIN motocicleta m
    ON v.numero_chasis = m.numero_chasis
INNER JOIN modelo_motocicleta mm
    ON m.id_modelo = mm.id_modelo

-- Agrupamos por vendedor, cliente y modelo.
GROUP BY
    p.nombre,
    p.apellido,
    pc.nombre,
    pc.apellido,
    mm.nombre_modelo

-- Mostramos solo los grupos con dos o más ventas.
HAVING COUNT(v.cod_venta) >= 2

ORDER BY total_vendido DESC;
