USE [X MOTORS];



-- ETAPA IV - CONSULTA 1
-- Factura o comprobante de una venta.

DECLARE @cod_venta INT = 1;

-- Obtengo el detalle de la motocicleta y los accesorios.
WITH Renglones AS (

  
    SELECT
        v.cod_venta,
        'Motocicleta' AS tipo,
        mm.nombre_modelo AS descripcion,
        1 AS cantidad,
        v.precio_venta_moto AS precio_unitario,
        v.precio_venta_moto AS subtotal
    FROM venta v
    INNER JOIN motocicleta m
        ON v.numero_chasis = m.numero_chasis
    INNER JOIN modelo_motocicleta mm
        ON m.id_modelo = mm.id_modelo
    WHERE v.cod_venta = @cod_venta

    UNION ALL

    -- Agregego los accesorios de la misma venta.
    SELECT
        dva.cod_venta,
        'Accesorio' AS tipo,
        a.descripcion,
        dva.cantidad,
        dva.precio_pactado AS precio_unitario,
        dva.cantidad * dva.precio_pactado AS subtotal
    FROM detalle_venta_accesorio dva
    INNER JOIN accesorio a
        ON dva.id_accesorio = a.id_accesorio
    WHERE dva.cod_venta = @cod_venta
)

-- Muestro el comprobante completo.
SELECT
    v.cod_venta,
    v.fecha,
    pc.nombre + ' ' + pc.apellido AS cliente,
    pv.nombre + ' ' + pv.apellido AS vendedor,
    r.tipo,
    r.descripcion,
    r.cantidad,
    r.precio_unitario,
    r.subtotal,

    -- Sumamos todos los renglones de la venta.
    SUM(r.subtotal) OVER (
        PARTITION BY r.cod_venta
    ) AS total_calculado

FROM Renglones r
INNER JOIN venta v
    ON r.cod_venta = v.cod_venta
INNER JOIN cliente c
    ON v.dni_cliente = c.dni_cliente
INNER JOIN persona pc
    ON c.dni_cliente = pc.dni
INNER JOIN vendedor ve
    ON v.dni_vendedor = ve.dni_vendedor
INNER JOIN persona pv
    ON ve.dni_vendedor = pv.dni

ORDER BY r.tipo, r.descripcion;


